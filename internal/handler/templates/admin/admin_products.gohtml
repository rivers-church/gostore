{{define "content"}}

<h1>Products</h1>
{{/*
  Left out for a role that cannot create one, rather than rendered as a link to a
  403. requirePerm is what refuses it; this only keeps the page honest.
*/}}
{{if .Can "catalog.write"}}<p><a href="/admin/products/new">New product</a></p>{{end}}

{{if not .Products}}
  <p>No products yet.</p>
{{else}}
<table>
  <thead>
    <tr>
      <th>Title</th><th>Categories</th><th>Slug</th><th>Variants</th><th>Stock</th><th>Active</th><th></th>
    </tr>
  </thead>
  <tbody>
  {{range .Products}}
    <tr>
      <td>{{.Title}}</td>
      <td>{{if .Categories}}{{range $i, $c := .Categories}}{{if $i}}, {{end}}{{$c.Name}}{{end}}{{else}}—{{end}}</td>
      <td>{{.Slug}}</td>
      <td>{{len .Variants}}</td>
      <td>{{.TotalStock}}</td>
      <td>{{if .Active}}yes{{else}}no{{end}}</td>
      <td>{{if $.Can "catalog.write"}}<a href="/admin/products/{{.ID}}/edit">Edit</a>{{end}}</td>
    </tr>
  {{end}}
  </tbody>
</table>
{{end}}

{{end}}
