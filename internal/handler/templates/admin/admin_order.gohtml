{{define "content"}}

<a class="back" href="/admin/orders">← All orders</a>
<h1>Order {{.Order.Reference}}</h1>

{{/*
  There are no buttons on this page, and that is deliberate: an order records
  something that happened, and only an authenticated gateway notification may
  change one. A "mark as paid" button here would be a way to record money that
  never arrived.
*/}}

{{/* The state of the order in badges, because these three facts are what an
     operator checks first and a sentence makes them read them all. */}}
<p class="row">
  {{if .Order.Paid}}
    <span class="badge done">paid {{.Order.PaidAt.Format "2006-01-02 15:04"}}</span>
  {{else}}
    <span class="badge">{{.Order.Status}}</span>
  {{end}}
  {{if .Order.Oversold}}<span class="badge problem">oversold</span>{{end}}
  <span class="badge">placed {{.Order.CreatedAt.Format "2006-01-02 15:04"}}</span>
  <span class="badge">confirmation email {{if .Order.Emailed}}sent{{else}}not sent{{end}}</span>
</p>

{{/*
  Above everything else, because it is the one thing on this page that has to be
  decided before the parcel is packed.
*/}}
{{if .Order.Oversold}}
<div class="notice problem">
  <p><strong>Oversold — this order was paid but there was not enough stock left.</strong></p>
  <p>Stock was left as it stands rather than driven negative, so the counts under
  Products are still right for what is physically on the shelf. Somebody has to
  decide whether to fulfil this late or refund it. Nothing here does that for you:
  refunds happen in the {{.Order.Gateway}} dashboard, because this store models a
  forward payment only.</p>
</div>
{{end}}

<h2>Pack</h2>
<div class="scroll-x">
  <table>
    <thead>
      <tr>
        <th>Item</th><th>Options</th><th class="num">Unit</th>
        <th class="num">Qty</th><th class="num">Line total</th>
      </tr>
    </thead>
    <tbody>
    {{range .Order.Items}}
      <tr>
        {{/*
          The title and options are the snapshot taken when the order was placed, not
          a live read of the catalog — so this says what was bought even if the
          product has since been renamed, repriced or withdrawn.
        */}}
        <td>{{.Title}}</td>
        <td>{{with .Label}}{{.}}{{else}}<span class="muted">—</span>{{end}}</td>
        <td class="num">{{$.Currency}} {{money .UnitPriceCents}}</td>
        <td class="num">{{.Quantity}}</td>
        <td class="num">{{$.Currency}} {{money .LineTotalCents}}</td>
      </tr>
    {{end}}
    </tbody>
    <tfoot>
      <tr>
        <th colspan="3">Total ({{.Order.Count}} item{{if ne .Order.Count 1}}s{{end}})</th>
        <th class="num" colspan="2">{{.Currency}} {{money .Order.TotalCents}}</th>
      </tr>
    </tfoot>
  </table>
</div>

<h2>Ship to</h2>
<div class="panel">
  <p>
    <strong>{{.Order.Customer.Name}}</strong><br>
    {{linebreaks .Order.Customer.Address}}
  </p>
  <p>
    <a href="mailto:{{.Order.Customer.Email}}">{{.Order.Customer.Email}}</a>
    {{with .Order.Customer.Phone}}<br>{{.}}{{end}}
  </p>
</div>

<h2>Payment</h2>
<table class="facts">
  <tbody>
    <tr><th>Gateway</th><td>{{with .Order.Gateway}}{{.}}{{else}}—{{end}}</td></tr>
    <tr><th>Gateway reference</th><td>{{with .Order.GatewayRef}}{{.}}{{else}}—{{end}}</td></tr>
    <tr><th>Gateway status</th><td>{{with .Order.GatewayStatus}}{{.}}{{else}}—{{end}}</td></tr>
    <tr><th>Amount as received</th><td>{{with .Order.GatewayAmount}}{{.}}{{else}}—{{end}}</td></tr>
    <tr><th>Currency</th><td>{{.Order.Currency}}</td></tr>
    <tr><th>Order id</th><td><code>{{.Order.ID}}</code></td></tr>
  </tbody>
</table>

{{/*
  Downloads, and the only forms on this page.

  Everything else here is read-only on purpose — an order records what happened,
  and a button that changed it would be a way to record money that never arrived.
  Revoking is outside that rule rather than an exception to it: it changes no
  financial fact about the order, only whether one buyer's link still works.
*/}}
{{if .Entitlements}}
<h2>Downloads</h2>
<div class="scroll-x">
  <table>
    <thead>
      <tr><th>Product</th><th class="num">Times downloaded</th><th>State</th><th></th></tr>
    </thead>
    <tbody>
    {{range .Entitlements}}
      <tr>
        <td>{{.ProductTitle}}{{with .VariantLabel}} <small>{{.}}</small>{{end}}</td>
        <td class="num">{{.DownloadCount}}</td>
        <td>
          {{if .Revoked}}
            <span class="badge problem">revoked {{.RevokedAt.Format "2006-01-02"}}</span>
          {{else}}
            <span class="badge done">active</span>
          {{end}}
        </td>
        {{/* Absent for a role that may read an order but not change what it grants. */}}
        <td>
          {{if $.Can "orders.write"}}
            {{if .Revoked}}
            <form method="post" action="/admin/orders/{{$.Order.ID}}/entitlements/{{.ID}}/restore">
              {{template "csrf" $.CSRFToken}}
              <button type="submit">Restore</button>
            </form>
            {{else}}
            <form method="post" action="/admin/orders/{{$.Order.ID}}/entitlements/{{.ID}}/revoke">
              {{template "csrf" $.CSRFToken}}
              <button class="quiet" type="submit">Revoke</button>
            </form>
            {{end}}
          {{end}}
        </td>
      </tr>
    {{end}}
    </tbody>
  </table>
</div>
<small class="hint">Revoking stops this buyer and nobody else. It takes effect on their
next click; a download link they were handed in the last few minutes may still
complete. Revoking is reversible.</small>
{{end}}

{{/*
  The raw notification body, kept for the day a customer and a bank disagree about
  what happened. It is the gateway's own words, unedited.
*/}}
{{with .Order.GatewayPayload}}
<h3>Raw gateway notification</h3>
<pre class="raw">{{.}}</pre>
{{end}}

{{end}}
